<section class="intro">
  <div class="intro-portrait" data-avatars="<%= theme.avatars %>">
    <img src="<%- url_for('/images/avatar/01.webp') %>"
         srcset="<%- url_for('/images/avatar/01.webp') %> 320w, <%- url_for('/images/avatar/01@2x.webp') %> 640w"
         sizes="240px" width="240" height="240" alt="Iván Alonso" fetchpriority="high">
  </div>

  <div class="intro-text">
    <h1 class="intro-name"><%= config.title %></h1>
    <% var longest = theme.roles.reduce(function (a, b) { return b.length > a.length ? b : a; }); %>
    <p class="intro-role">
      <span class="intro-role-sizer" aria-hidden="true"><%= longest %></span>
      <span class="intro-role-value" data-roles="<%= JSON.stringify(theme.roles) %>"><%= theme.roles[0] %></span><span class="intro-caret" aria-hidden="true"></span>
    </p>
    <p class="intro-bio"><%= theme.bio %></p>
  </div>
</section>
